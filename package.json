{
  "name": "playwright-june-2026",
  "version": "1.0.0",
  "description": "Production-ready Playwright TypeScript framework for OpenMRS patient registration automation.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:patient-registration": "playwright test tests/patientRegistration/patientRegistration.spec.ts",
    "report:html": "playwright show-report reports/html",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "lint:types": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "openmrs",
    "healthcare"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.1",
    "dotenv": "^17.2.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "winston": "^3.18.3"
  },
  "dependencies": {
    "mysql2": "^3.15.3"
  }
}
